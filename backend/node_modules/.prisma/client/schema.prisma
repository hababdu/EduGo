// ============================================================
// PHASE 2 — DATABASE SCHEMA (PostgreSQL + Prisma)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// 1. USERS & ROLES
// ------------------------------------------------------------

enum RoleName {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  PENDING
}

model User {
  id              String        @id @default(cuid())
  telegramId      String        @unique
  username        String?
  firstName       String
  lastName        String?
  profilePhotoUrl String?
  role            RoleName      @default(STUDENT)
  status          AccountStatus @default(ACTIVE)
  registeredAt    DateTime      @default(now())
  lastActiveAt    DateTime      @default(now())
  deletedAt       DateTime? // soft delete

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  adminProfile   AdminProfile?

  groupMemberships  GroupMember[]
  scoreTransactions ScoreTransaction[]   @relation("ScoreOwner")
  adminScoreActions ScoreTransaction[]   @relation("ScoreCreatedBy")
  xpTransactions    XPTransaction[]
  achievements      StudentAchievement[]
  testAttempts      TestAttempt[]
  notifications     Notification[]
  adminActionLogs   AdminActionLog[]     @relation("AuditActor")
  activityLogs      ActivityLog[]
  streak            Streak?

  createdCourses       Course[]         @relation("CourseCreatedBy")
  taughtGroups         Group[]          @relation("GroupTeacher")
  createdTests         Test[]           @relation("TestCreatedBy")
  createdQuestions     Question[]       @relation("QuestionCreatedBy")
  assignedTests        TestAssignment[] @relation("AssignedBy")
  createdAnnouncements Announcement[]   @relation("AnnouncementCreatedBy")

  @@index([telegramId])
  @@index([role])
}

model StudentProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  totalScore Int     @default(0)
  totalXp    Int     @default(0)
  level      Int     @default(1)
  bio        String?
}

model TeacherProfile {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])
  bio    String?
}

model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// ------------------------------------------------------------
// 2. GROUPS
// ------------------------------------------------------------

model Group {
  id        String    @id @default(cuid())
  name      String // masalan "9-A"
  teacherId String?
  teacher   User?     @relation("GroupTeacher", fields: [teacherId], references: [id])
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  members         GroupMember[]
  testAssignments TestAssignment[]

  @@index([teacherId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

// ------------------------------------------------------------
// 3. LEARNING HIERARCHY: Course → Subject → Section → Topic → Lesson
// ------------------------------------------------------------

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String?
  posterUrl   String?
  status      ContentStatus @default(DRAFT)
  createdById String
  createdBy   User          @relation("CourseCreatedBy", fields: [createdById], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  subjects Subject[]

  @@index([status])
}

model Subject {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])
  title       String
  description String?
  posterUrl   String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  deletedAt   DateTime?

  sections Section[]
  tests    Test[]

  @@index([courseId])
}

model Section {
  id          String        @id @default(cuid())
  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id])
  title       String
  description String?
  posterUrl   String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  deletedAt   DateTime?

  topics Topic[]

  @@index([subjectId])
}

model Topic {
  id               String        @id @default(cuid())
  sectionId        String
  section          Section       @relation(fields: [sectionId], references: [id])
  title            String
  description      String?
  posterUrl        String?
  order            Int           @default(0)
  status           ContentStatus @default(DRAFT)
  sequentialLocked Boolean       @default(false) // oldingi topic tugamaguncha yopiqmi
  deletedAt        DateTime?

  lessons Lesson[]
  tests   Test[]

  @@index([sectionId])
}

model Lesson {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id])
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  materials Material[]
  videos    Video[]

  @@index([topicId])
}

enum VideoSource {
  YOUTUBE
  TELEGRAM
  EXTERNAL_URL
  CLOUD_STORAGE
}

model Video {
  id       String      @id @default(cuid())
  lessonId String
  lesson   Lesson      @relation(fields: [lessonId], references: [id])
  source   VideoSource
  url      String
  duration Int? // seconds

  progress VideoProgress[]
}

model VideoProgress {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  studentId String
  percent   Int      @default(0) // 0,25,50,75,100
  updatedAt DateTime @updatedAt

  @@unique([videoId, studentId])
}

enum MaterialType {
  PDF
  DOC
  PPT
  IMAGE
  OTHER
}

model Material {
  id           String       @id @default(cuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id])
  type         MaterialType
  fileUrl      String
  title        String
  downloadable Boolean      @default(true)
}

// ------------------------------------------------------------
// 4. QUESTION BANK
// ------------------------------------------------------------

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  TEXT_ANSWER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id          String        @id @default(cuid())
  subjectId   String?
  topicId     String?
  type        QuestionType
  difficulty  Difficulty    @default(MEDIUM)
  text        String
  explanation String?
  points      Int           @default(1)
  tags        String[]
  createdById String
  createdBy   User          @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  status      ContentStatus @default(DRAFT)
  deletedAt   DateTime?

  options       AnswerOption[]
  testQuestions TestQuestion[]
  answers       TestAnswer[]

  @@index([subjectId])
  @@index([topicId])
  @@index([difficulty])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  text       String
  isCorrect  Boolean  @default(false) // FRONTENDGA HECH QACHON to'g'ridan-to'g'ri yuborilmaydi
  order      Int      @default(0)

  @@index([questionId])
}

// ------------------------------------------------------------
// 5. TESTS
// ------------------------------------------------------------

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Test {
  id                String     @id @default(cuid())
  title             String
  description       String?
  posterUrl         String?
  subjectId         String?
  subject           Subject?   @relation(fields: [subjectId], references: [id])
  topicId           String?
  topic             Topic?     @relation(fields: [topicId], references: [id])
  durationSeconds   Int // server-side timer bazasi
  passingScore      Int // percent, masalan 70
  maxScore          Int // hisoblab qo'yiladi yoki qo'lda
  randomQuestions   Boolean    @default(false)
  randomAnswerOrder Boolean    @default(false)
  questionCount     Int? // random bo'lsa nechta savol tanlanadi
  startDate         DateTime?
  endDate           DateTime?
  status            TestStatus @default(DRAFT)
  createdById       String
  createdBy         User       @relation("TestCreatedBy", fields: [createdById], references: [id])
  deletedAt         DateTime?

  questions   TestQuestion[]
  assignments TestAssignment[]
  sessions    TestSession[]
  attempts    TestAttempt[]

  @@index([subjectId])
  @@index([status])
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      @default(0)

  @@unique([testId, questionId])
}

enum AssignmentTargetType {
  ALL
  GROUP
  INDIVIDUAL
}

enum AssignmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model TestAssignment {
  id           String               @id @default(cuid())
  testId       String
  test         Test                 @relation(fields: [testId], references: [id])
  targetType   AssignmentTargetType
  groupId      String?
  group        Group?               @relation(fields: [groupId], references: [id])
  studentId    String? // individual assignment uchun
  assignedById String
  assignedBy   User                 @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime             @default(now())
  deadline     DateTime?
  status       AssignmentStatus     @default(ACTIVE)

  @@index([testId])
  @@index([groupId])
  @@index([studentId])
}

// ------------------------------------------------------------
// 6. TEST SESSION / ATTEMPT (anti-cheat, server-authoritative)
// ------------------------------------------------------------

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model TestSession {
  id                  String        @id @default(cuid())
  testId              String
  test                Test          @relation(fields: [testId], references: [id])
  studentId           String
  startedAt           DateTime      @default(now()) // SERVER vaqti - source of truth
  durationSeconds     Int // testdan nusxa olinadi, keyin o'zgarmaydi
  selectedQuestionIds String[] // random tanlangan bo'lsa shu yerda saqlanadi (barqarorlik uchun)
  answerOrderSeed     Int? // random answer shuffle uchun deterministik seed
  status              SessionStatus @default(IN_PROGRESS)

  answers TestAnswer[]

  @@unique([testId, studentId]) // "bir marta ishlash" qoidasi shu yerdan boshlanadi
  @@index([studentId])
  @@index([status])
}

enum AttemptStatus {
  COMPLETED
  RETAKE_GRANTED
}

model TestAttempt {
  id               String        @id @default(cuid())
  testId           String
  test             Test          @relation(fields: [testId], references: [id])
  studentId        String
  student          User          @relation(fields: [studentId], references: [id])
  sessionId        String        @unique
  score            Int
  maxScore         Int
  percent          Float
  passed           Boolean
  timeSpentSeconds Int
  status           AttemptStatus @default(COMPLETED)
  isRetakeAllowed  Boolean       @default(false) // faqat admin ON qilganda true
  completedAt      DateTime      @default(now())

  @@unique([testId, studentId]) // asosiy "bir marta" cheklovi
  @@index([studentId])
  @@index([testId])
}

model TestAnswer {
  id                String      @id @default(cuid())
  sessionId         String
  session           TestSession @relation(fields: [sessionId], references: [id])
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id])
  selectedOptionIds String[]
  textAnswer        String?
  isCorrect         Boolean? // faqat submit'dan keyin to'ldiriladi
  answeredAt        DateTime    @default(now())

  @@unique([sessionId, questionId])
}

// ------------------------------------------------------------
// 7. SCORE WALLET (ScoreTransaction — ledger pattern)
// ------------------------------------------------------------

enum ScoreTransactionType {
  TEST_REWARD
  ADMIN_ADD
  ADMIN_REMOVE
  BONUS
  PENALTY
  ACHIEVEMENT
  CHALLENGE
}

model ScoreTransaction {
  id          String               @id @default(cuid())
  studentId   String
  student     User                 @relation("ScoreOwner", fields: [studentId], references: [id])
  amount      Int // musbat yoki manfiy bo'lishi mumkin
  type        ScoreTransactionType
  subjectId   String? // fan bo'yicha ball ajratish uchun
  testId      String?
  description String?
  createdById String? // admin qo'lda bergan bo'lsa
  createdBy   User?                @relation("ScoreCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([studentId])
  @@index([subjectId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// 8. GAMIFICATION: XP, Level, Achievement, Streak, Challenge
// ------------------------------------------------------------

enum XPSourceType {
  LESSON_VIEW
  TEST_COMPLETE
  CHALLENGE
  HOMEWORK
  ACHIEVEMENT
}

model XPTransaction {
  id        String       @id @default(cuid())
  studentId String
  student   User         @relation(fields: [studentId], references: [id])
  amount    Int
  source    XPSourceType
  createdAt DateTime     @default(now())

  @@index([studentId])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique // masalan "FIRST_TEST", "PERFECT_SCORE"
  title       String
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(cuid())
  studentId     String
  student       User        @relation(fields: [studentId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([studentId, achievementId])
}

model Streak {
  id             String    @id @default(cuid())
  studentId      String    @unique
  student        User      @relation(fields: [studentId], references: [id])
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  date        DateTime // shu kunga tegishli challenge
  testId      String? // challenge alohida mini-test sifatida modellashtiriladi
  rewardScore Int
  rewardXp    Int
  createdAt   DateTime @default(now())

  @@index([date])
}

// ------------------------------------------------------------
// 9. NOTIFICATIONS & ANNOUNCEMENTS
// ------------------------------------------------------------

enum NotificationType {
  TEST_ASSIGNED
  TEST_RESULT
  RANKING_CHANGE
  DEADLINE_REMINDER
  NEW_LESSON
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  type            NotificationType
  title           String
  body            String
  isRead          Boolean          @default(false)
  sentViaTelegram Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model Announcement {
  id                  String   @id @default(cuid())
  title               String
  body                String
  createdById         String
  createdBy           User     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  groupId             String? // null bo'lsa hammaga
  publishedOnTelegram Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([groupId])
}

// ------------------------------------------------------------
// 9b. AUTH — REFRESH TOKENS (rotation bilan)
// ------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // xom token hech qachon DB'da saqlanmaydi, faqat hash
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // rotation zanjiri uchun (audit maqsadida)

  @@index([userId])
  @@index([tokenHash])
}

// ------------------------------------------------------------
// 10. AUDIT & ACTIVITY LOG
// ------------------------------------------------------------

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // masalan "SCORE_ADJUST", "TEST_REOPEN", "STUDENT_BLOCK"
  targetType String // masalan "Test", "User"
  targetId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // masalan "LOGIN", "TEST_STARTED", "LESSON_VIEWED"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
