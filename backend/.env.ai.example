# ─────────────────────────────────────────────────────────────
# AI sozlamalari — bularni backend/.env (yoki Render Environment) ga qo'shing.
# Kalitlarni HECH QACHON frontendga (VITE_*) qo'ymang va git'ga commit qilmang.
# ─────────────────────────────────────────────────────────────

# Asosiy provayder: anthropic | groq
AI_PROVIDER=anthropic
# Ixtiyoriy zaxira (asosiy ishlamasa/limit bo'lsa avtomatik o'tadi): anthropic | groq
AI_FALLBACK_PROVIDER=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# --- Groq (yoki istalgan OpenAI-mos xizmat) ---
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-20b

# --- Limitlar ---
# Kunlik token chegarasi (kirish+chiqish), rol bo'yicha. 0 = cheklanmagan.
# AI_DAILY_TOKENS_STUDENT=30000
# AI_DAILY_TOKENS_TEACHER=150000
# AI_DAILY_TOKENS_ADMIN=300000
# AI_DAILY_TOKENS_SUPER_ADMIN=0
# Student test topshirayotganda AIAnswerCheck (javobni AI bilan tekshirish) ishlasinmi.
# false = test davomida to'liq o'chiriladi (anti-cheat). Tutor/chat/tavsiya baribir bloklanadi.
# AI_ALLOW_GRADE_DURING_TEST=true
# AI_TZ_OFFSET_HOURS=5
# AI_TIMEOUT_MS=60000
# AI_STREAM_TIMEOUT_MS=120000
# AI_MAX_TOKENS=1024
